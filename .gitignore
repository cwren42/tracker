backups/
*.sql
*.sql.gz

# Generated artifacts (regenerated on demand; not source)
static/evidence/
static/agent/

# Logs
*.log
access.log
error.log

# Python
__pycache__/
*.py[cod]
*.pyo
.Python

# Virtual environment
venv/
env/
.venv/

# Environment / secrets
.env
.env.*
.secrets.env
*.key
*.pem

# Screenshots / uploads
screenshots/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*~

# Exchange Online app-only auth (cert + key + pfx) — never commit
.exo_auth/
*.pfx

# Agent update signing private key — never commit
.agent_signing/
