        document.getElementById('ai-ticket-enabled').checked   = d.ai_ticket_enabled === '1';
        document.getElementById('ai-auto-mode').checked        = d.ai_ticket_auto_mode === '1';
        document.getElementById('ai-security-monitor').checked = d.ai_security_monitor_enabled === '1';
    } catch(e) {}
