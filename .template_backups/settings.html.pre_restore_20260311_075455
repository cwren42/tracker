{% extends "base.html" %}

{% block title %}System Settings{% endblock %}

{% block content %}
<style>
    #settingsTabs .nav-link { color:#8899aa; border-bottom:2px solid transparent; }
    #settingsTabs .nav-link.active { color:#fff; background:transparent; }
    #settingsTabs .nav-link:hover { color:#cdd9e5; }
    #settingsTabs .nav-link i { margin-right: 5px; }
    .tab-content { min-height: 400px; }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="h2">
                <i class="bi bi-gear-fill text-primary"></i> System Settings
            </h1>
            <p class="text-muted">Configure application preferences and integrations</p>
        </div>
    </div>

    <!-- License Expiration Warning Banner -->
    <div class="row" id="licenseWarningBanner" style="display: none;">
        <div class="col-12">
            <div class="alert alert-danger alert-dismissible fade show border-3 shadow-sm" role="alert">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i> License Expired or Invalid
                </h4>
                <p class="mb-2">
                    <strong>The system license has expired or is invalid.</strong> 
                    All features are currently locked. Please update your license information in the License tab below to restore full functionality.
                </p>
                <hr>
                <p class="mb-0">
                    <small><i class="bi bi-info-circle"></i> Contact your administrator or visit the License tab to enter a valid license key.</small>
                </p>
            </div>
        </div>
    </div>

    <!-- Tabbed Interface -->
    <div class="row">
        <div class="col-12">
            <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="license-tab" data-bs-toggle="tab" data-bs-target="#license" type="button" role="tab">
                        <i class="bi bi-key-fill"></i> License
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#email" type="button" role="tab">
                        <i class="bi bi-envelope-fill"></i> Email
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="directory-tab" data-bs-toggle="tab" data-bs-target="#directory" type="button" role="tab">
                        <i class="bi bi-server"></i> Directory
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="rmm-tab" data-bs-toggle="tab" data-bs-target="#rmm" type="button" role="tab">
                        <i class="bi bi-robot"></i> RMM Agent
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="unifi-tab" data-bs-toggle="tab" data-bs-target="#unifi" type="button" role="tab">
                        <i class="bi bi-router"></i> UniFi
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="proxmox-tab" data-bs-toggle="tab" data-bs-target="#proxmox" type="button" role="tab">
                        <i class="bi bi-hdd-stack"></i> Proxmox
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="ai-tab" data-bs-toggle="tab" data-bs-target="#ai" type="button" role="tab">
                        <i class="bi bi-stars"></i> AI
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="scripts-tab" data-bs-toggle="tab" data-bs-target="#scripts" type="button" role="tab">
                        <i class="bi bi-terminal-fill"></i> Scripts
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="eagleeye-tab" data-bs-toggle="tab" data-bs-target="#eagleeye" type="button" role="tab">
                        <i class="bi bi-binoculars-fill"></i> Eagle Eye
                    </button>
                </li>
            </ul>

            <div class="tab-content mt-4" id="settingsTabContent">
                <!-- License Management Tab -->
                <div class="tab-pane fade show active" id="license" role="tabpanel">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="bi bi-key-fill"></i> License Management</h5>
                                    <button type="button" class="btn btn-sm btn-light" onclick="verifyLicense()">
                                        <i class="bi bi-arrow-clockwise"></i> Verify Now
                                    </button>
                                </div>
                                <div class="card-body">
                                    <div id="licenseInfo">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Add/Edit License Form (hidden by default) -->
                                    <div id="licenseForm" style="display: none;">
                                        <form onsubmit="saveLicense(event)">
                                            <div class="mb-3">
                                                <label class="form-label">License Key *</label>
                                                <input type="text" class="form-control" id="licenseKey" placeholder="LIC-XXXXX-XXXXX-XXXXX-XXXXX" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">License Server API Key</label>
                                                <input type="text" class="form-control" id="apiKey" placeholder="sk_...">
                                                <small class="text-muted">Optional: Leave blank to use server default</small>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Device ID</label>
                                                <input type="text" class="form-control" id="deviceId" placeholder="asset-tracker-hostname">
                                                <small class="text-muted">Optional: Unique identifier for this installation. Auto-generated if not specified.</small>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Company Name</label>
                                                <input type="text" class="form-control" id="companyName" placeholder="Your Company">
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bi bi-check-circle"></i> Save License
                                                </button>
                                                <button type="button" class="btn btn-secondary" onclick="cancelEditLicense()">
                                                    Cancel
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Email Configuration Tab -->
                <div class="tab-pane fade" id="email" role="tabpanel">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-envelope-fill"></i> Email Configuration</h5>
                    <button type="button" class="btn btn-sm btn-light" onclick="toggleSmtpEdit()">
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>
                </div>
                <div class="card-body">
                    <!-- View Mode -->
                    <div id="smtpViewMode">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6 class="text-muted">SMTP Server</h6>
                                <p class="mb-0"><strong>{{ config.mail_server }}</strong></p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Port</h6>
                                <p class="mb-0"><strong>{{ config.mail_port }}</strong></p>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6 class="text-muted">Username</h6>
                                <p class="mb-0">{{ config.mail_username if config.mail_username else '<span class="text-muted">Not set</span>' | safe }}</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Encryption</h6>
                                <p class="mb-0">
                                    {% if config.mail_use_tls %}
                                        <span class="badge bg-success">TLS Enabled</span>
                                    {% elif config.mail_use_ssl %}
                                        <span class="badge bg-success">SSL Enabled</span>
                                    {% else %}
                                        <span class="badge bg-secondary">None</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <h6 class="text-muted">Sender Email</h6>
                                <p class="mb-0"><strong>{{ config.mail_sender }}</strong></p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Edit Mode -->
                    <form method="POST" id="smtpEditMode" style="display: none;">
                        <input type="hidden" name="action" value="update_smtp">
                        
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> <strong>Common SMTP Ports:</strong> 25 (unencrypted), 587 (TLS), 465 (SSL)
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label">SMTP Server *</label>
                                <input type="text" class="form-control" name="smtp_server" 
                                       value="{{ config.mail_server }}" required 
                                       placeholder="smtp.gmail.com">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Port *</label>
                                <input type="number" class="form-control" name="smtp_port" 
                                       value="{{ config.mail_port }}" required 
                                       placeholder="587">
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Username (optional)</label>
                                <input type="text" class="form-control" name="smtp_username" 
                                       value="{{ config.mail_username }}" 
                                       placeholder="your@email.com">
                                <small class="text-muted">Leave blank if not required</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Password (optional)</label>
                                <input type="password" class="form-control" name="smtp_password" 
                                       value="{{ config.mail_password }}" 
                                       placeholder="••••••••">
                                <small class="text-muted">Leave blank to keep existing</small>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Encryption</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="use_tls" id="use_tls" 
                                       {% if config.mail_use_tls %}checked{% endif %}>
                                <label class="form-check-label" for="use_tls">
                                    Use TLS (Port 587)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="use_ssl" id="use_ssl" 
                                       {% if config.mail_use_ssl %}checked{% endif %}>
                                <label class="form-check-label" for="use_ssl">
                                    Use SSL (Port 465)
                                </label>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Sender Email *</label>
                            <input type="email" class="form-control" name="sender_email" 
                                   value="{{ config.mail_sender }}" required 
                                   placeholder="noreply@company.com">
                            <small class="text-muted">This will appear as the "From" address</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="toggleSmtpEdit()">
                                <i class="bi bi-x-circle"></i> Cancel
                            </button>
                        </div>
                    </form>

                                    <!-- Test Email -->
                                    <hr>
                                    <form method="POST">
                                        <input type="hidden" name="action" value="test_email">
                                        <div class="mb-3">
                                            <label class="form-label"><strong>Test Email Configuration</strong></label>
                                            <div class="input-group">
                                                <input type="email" class="form-control" name="test_email" 
                                                       placeholder="Enter email address to test" required>
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bi bi-send-fill"></i> Send Test Email
                                                </button>
                                            </div>
                                            <small class="form-text text-muted">Send a test email to verify SMTP configuration</small>
                                        </div>
                                    </form>

                                    <!-- Email Notifications -->
                                    <div class="card shadow-sm mt-4">
                                        <div class="card-header">
                                            <h5 class="mb-0"><i class="bi bi-bell-fill"></i> Email Notifications</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    <h6 class="mb-1">Employee Email Notifications</h6>
                                                    <p class="text-muted mb-0 small">Send emails to employees when assets are assigned to them</p>
                                                </div>
                                                <form method="POST" class="mb-0">
                                                    <input type="hidden" name="action" value="toggle_employee_emails">
                                                    <button type="submit" class="btn btn-lg {{ 'btn-success' if config.employee_emails_enabled else 'btn-secondary' }}">
                                                        {% if config.employee_emails_enabled %}
                                                            <i class="bi bi-toggle-on"></i> Enabled
                                                        {% else %}
                                                            <i class="bi bi-toggle-off"></i> Disabled
                                                        {% endif %}
                                                    </button>
                                                </form>
                                            </div>
                                            
                                            {% if not config.employee_emails_enabled %}
                                            <div class="alert alert-warning mb-0">
                                                <i class="bi bi-exclamation-triangle-fill"></i> 
                                                <strong>Note:</strong> Employee email notifications are currently disabled. 
                                                Employees will not receive emails when assets are assigned to them.
                                            </div>
                                            {% endif %}
                                            
                                            <hr>
                                            
                                            <h6 class="mb-3">Admin Notifications (Always Enabled)</h6>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-2">
                                                    <i class="bi bi-check-circle-fill text-success"></i> 
                                                    Warranty expiring alerts
                                                </li>
                                                <li class="mb-2">
                                                    <i class="bi bi-check-circle-fill text-success"></i> 
                                                    Asset lifecycle alerts (replacement needed)
                                                </li>
                                                <li class="mb-2">
                                                    <i class="bi bi-check-circle-fill text-success"></i> 
                                                    System notifications
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Email Info Sidebar -->
                                <div class="col-lg-4">
                                    <!-- Admin Recipients -->
                                    <div class="card shadow-sm mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0"><i class="bi bi-people-fill"></i> Admin Recipients</h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="text-muted small mb-2">Admin notifications will be sent to:</p>
                                            {% if config.admin_emails %}
                                                <ul class="list-unstyled mb-0">
                                                    {% for email in config.admin_emails %}
                                                    <li class="mb-2">
                                                        <i class="bi bi-envelope text-primary"></i> 
                                                        <small>{{ email }}</small>
                                                    </li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                <div class="alert alert-warning mb-0">
                                                    <small>
                                                        <i class="bi bi-exclamation-triangle"></i> 
                                                        No admin email addresses configured!
                                                    </small>
                                                </div>
                                            {% endif %}
                                            <hr>
                                            <p class="text-muted small mb-0">
                                                <strong>{{ config.admin_count }}</strong> admin user(s) in system
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Email Types -->
                                    <div class="card shadow-sm mb-4">
                                        <div class="card-header">
                                            <h5 class="mb-0"><i class="bi bi-info-circle-fill"></i> Email Types</h5>
                                        </div>
                                        <div class="card-body">
                                            <h6 class="mb-2">To Employees:</h6>
                                            <ul class="small mb-3">
                                                <li>Asset assignment notifications</li>
                                                <li>Asset return reminders</li>
                                            </ul>
                                            
                                            <h6 class="mb-2">To Admins:</h6>
                                            <ul class="small mb-0">
                                                <li>Warranty expiring soon (30 days)</li>
                                                <li>Assets needing replacement</li>
                                                <li>Lifecycle status changes</li>
                                                <li>System alerts</li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- SMTP Info -->
                                    <div class="card shadow-sm">
                                        <div class="card-header">
                                            <h6 class="mb-0"><i class="bi bi-server"></i> SMTP Server Info</h6>
                                        </div>
                                        <div class="card-body">
                                            <dl class="row mb-0 small">
                                                <dt class="col-sm-5">Server:</dt>
                                                <dd class="col-sm-7">{{ config.mail_server }}</dd>
                                                
                                                <dt class="col-sm-5">Port:</dt>
                                                <dd class="col-sm-7">{{ config.mail_port }}</dd>
                                                
                                                <dt class="col-sm-5">TLS:</dt>
                                                <dd class="col-sm-7">Disabled</dd>
                                                
                                                <dt class="col-sm-5">SSL:</dt>
                                                <dd class="col-sm-7">Disabled</dd>
                                                
                                                <dt class="col-sm-5">Auth:</dt>
                                                <dd class="col-sm-7 mb-0">None Required</dd>
                                            </dl>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Directory / AD / LDAP Tab -->
                <div class="tab-pane fade" id="directory" role="tabpanel">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="bi bi-server"></i> On-Prem Active Directory (LDAP)</h5>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="testADConnection()">
                                        <i class="bi bi-lightning"></i> Test Connection
                                    </button>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted mb-3">Configure LDAP/LDAPS to manage users and groups in on-prem AD.</p>
                                    <form method="POST">
                                        <input type="hidden" name="action" value="update_ad">
                                        <div class="row">
                                            <div class="col-md-8 mb-3">
                                                <label class="form-label">AD Server / Domain Controller <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="ad_server" value="{{ ad_config.ad_server }}" placeholder="dc01.corp.example.com or 10.0.0.10" required>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label class="form-label">LDAP Port <span class="text-danger">*</span></label>
                                                <input type="number" class="form-control" name="ad_port" value="{{ ad_config.ad_port }}" placeholder="636" required>
                                                <small class="form-text text-muted">389 (LDAP) or 636 (LDAPS)</small>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Base DN <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" name="ad_base_dn" value="{{ ad_config.ad_base_dn }}" placeholder="DC=corp,DC=example,DC=com" required>
                                            <small class="form-text text-muted">Base DN for user searches.</small>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Bind DN (Service Account) <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="ad_bind_username" value="{{ ad_config.ad_bind_username }}" placeholder="CN=Service,OU=Service Accounts,DC=corp,DC=example,DC=com" required>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Service Account Password</label>
                                                <input type="password" class="form-control" name="ad_bind_password" value="" placeholder="Leave blank to keep existing">
                                                <small class="form-text text-muted">Leave blank to keep the existing password.</small>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">User OU DN (optional)</label>
                                            <input type="text" class="form-control" name="ad_user_ou_dn" value="{{ ad_config.ad_user_ou_dn }}" placeholder="OU=Users,DC=corp,DC=example,DC=com">
                                            <small class="form-text text-muted">If set, new users can be created under this OU.</small>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="ad_use_ssl" id="adUseSSL" {{ 'checked' if ad_config.ad_use_ssl else '' }}>
                                            <label class="form-check-label" for="adUseSSL"><strong>Use SSL/TLS (LDAPS)</strong></label>
                                        </div>
                                        <div class="form-check mb-3">
                                            <input class="form-check-input" type="checkbox" name="ad_enabled" id="adEnabled" {{ 'checked' if ad_config.ad_enabled else '' }}>
                                            <label class="form-check-label" for="adEnabled"><strong>Enable AD Integration</strong></label>
                                        </div>
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-save"></i> Save Directory Settings
                                        </button>
                                    </form>
                                    <div class="mt-3" id="adTestResult" style="display:none;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RMM Agent Tab -->
                <div class="tab-pane fade" id="rmm" role="tabpanel">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="bi bi-robot"></i> Cirque RMM Agent</h5>
                                </div>
                                <div class="card-body">
                                    <p class="mb-3">Deploy the RMM agent to any Windows device &mdash; no file transfer needed.</p>

                                    <h6 class="mb-2"><i class="bi bi-1-circle-fill text-primary me-1"></i> Quick install &mdash; one machine (run as Admin)</h6>
                                    <p class="small text-muted mb-1">Open <strong>PowerShell as Administrator</strong> on the target machine and paste:</p>
                                    <div class="input-group mb-1">
                                        <input type="text" class="form-control font-monospace bg-dark text-light border-secondary"
                                                 id="ps1OneLiner" readonly style="font-size:.75rem;">
                                        <button class="btn btn-outline-secondary" type="button"
                                                onclick="copyById('ps1OneLiner',this)" title="Copy to clipboard">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                    <script>
                                    function copyById(id, btn) {
                                        navigator.clipboard.writeText(document.getElementById(id).value).then(function() {
                                            btn.innerHTML = '<i class="bi bi-check text-success"></i>';
                                            setTimeout(function() { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
                                        }).catch(function(){});
                                    }
                                    document.addEventListener('DOMContentLoaded', function() {
                                        var tok  = "{{ rmm_site_token }}";
                                        var base = "{{ request.host_url }}".replace(/\/+$/, "");
                                        var installUrl = base + "/download/site-install.ps1?t=" + tok;
                                        var deployUrl  = base + "/download/deploy-silent.ps1?t=" + tok;
                                        var sslBypass = "[Net.ServicePointManager]::ServerCertificateValidationCallback={$true}; ";
                                        document.getElementById("ps1OneLiner").value  = sslBypass + "irm '" + installUrl + "' -UseBasicParsing | iex";
                                        document.getElementById("gpoOneLiner").value  = sslBypass + "irm '" + deployUrl  + "' -UseBasicParsing | iex";
                                        document.getElementById("intuneScriptUrl").value = deployUrl;
                                        document.getElementById("psremoteCmd").value  =
                                            "Invoke-Command -ComputerName PC-NAME -ScriptBlock { irm '" + deployUrl + "' | iex }";
                                        document.getElementById("intuneDownloadLink").href = deployUrl;
                                    });
                                    </script>
                                    <p class="small text-muted mb-4">Logs saved to <code>C:\CirqueRMM\logs\setup.log</code></p>

                                    <h6 class="mb-2"><i class="bi bi-2-circle-fill text-success me-1"></i> Silent mass deployment &mdash; users see nothing</h6>
                                    <p class="small text-muted mb-2">The silent deploy script creates a hidden Windows Scheduled Task running as <strong>SYSTEM</strong>. No console window, no UAC prompt, no user dialog. Machines that already have the agent installed exit immediately.</p>

                                    <div class="border rounded p-3 mb-3 bg-dark bg-opacity-25">
