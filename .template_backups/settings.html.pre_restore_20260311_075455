    btn.disabled = false; btn.innerHTML = '<i class="bi bi-lightning-fill me-1"></i>Generate Now';
}

function showSettingsToast(msg, type) {
    const t = document.createElement('div');
    t.className = `alert alert-${type} position-fixed`;
    t.style.cssText = 'bottom:20px;right:20px;z-index:9999;min-width:220px;font-size:.88rem';
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3500);
}

