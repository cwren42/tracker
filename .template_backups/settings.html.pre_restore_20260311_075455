// ── Eagle Eye Exclusions (shuttle widget) ─────────────────────────────────────
// In-memory state: agent_id -> {hostname, excluded}
const eeState = {};

async function eeLoadExclusions() {
    eeSetStatus('<span class="spinner-border spinner-border-sm me-1"></span>Loading…');
    try {
        const r = await fetch('/api/settings/eagle-eye-exclusions');
        const d = await r.json();
        if (!d.ok) { eeSetStatus('<span class="text-danger">' + d.error + '</span>'); return; }

        // Reset state
        for (const k in eeState) delete eeState[k];

        d.all_agents.forEach(a => {
            eeState[a.agent_id] = {hostname: a.hostname, excluded: false};
        });
        d.exclusions.forEach(ex => {
            if (!eeState[ex.agent_id]) eeState[ex.agent_id] = {hostname: ex.hostname || ex.agent_id, excluded: false};
            eeState[ex.agent_id].excluded = true;
        });

        eeRenderLists();
        eeSetStatus('');
    } catch(e) {
        eeSetStatus('<span class="text-danger">' + e + '</span>');
    }
}

function eeRenderLists() {
    const activeList   = document.getElementById('ee-active-list');
    const excludedList = document.getElementById('ee-excluded-list');
    const fActive   = (document.getElementById('ee-filter-active')?.value || '').toLowerCase();
    const fExcluded = (document.getElementById('ee-filter-excluded')?.value || '').toLowerCase();

    activeList.innerHTML   = '';
    excludedList.innerHTML = '';

    let activeCount = 0, excludedCount = 0;

    Object.entries(eeState).sort((a,b) => (a[1].hostname||a[0]).localeCompare(b[1].hostname||b[0])).forEach(([aid, info]) => {
        const label = info.hostname && info.hostname !== aid ? `${info.hostname}  (${aid})` : aid;
        const opt = document.createElement('option');
        opt.value = aid;
        opt.textContent = label;
        if (info.excluded) {
            excludedCount++;
            if (!fExcluded || label.toLowerCase().includes(fExcluded)) excludedList.appendChild(opt);
        } else {
            activeCount++;
            if (!fActive || label.toLowerCase().includes(fActive)) activeList.appendChild(opt);
        }
    });

    document.getElementById('ee-active-count').textContent   = activeCount;
    document.getElementById('ee-excluded-count').textContent = excludedCount;
}

function eeFilterList(listId, query) {
    eeRenderLists();
}

async function eeMoveToExcluded() {
    const list = document.getElementById('ee-active-list');
    const selected = Array.from(list.selectedOptions).map(o => o.value);
    if (!selected.length) return;
    eeSetStatus('<span class="spinner-border spinner-border-sm me-1"></span>Saving…');
    let errors = [];
    for (const aid of selected) {
        try {
            const r = await fetch('/api/settings/eagle-eye-exclusions', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({agent_id: aid, notes: ''})
            });
            const d = await r.json();
            if (d.ok) { if (eeState[aid]) eeState[aid].excluded = true; }
            else errors.push(aid + ': ' + d.error);
        } catch(e) { errors.push(aid + ': ' + e); }
    }
    if (errors.length) eeSetStatus('<span class="text-danger">' + errors.join('; ') + '</span>');
    else eeSetStatus('<span class="text-success"><i class="bi bi-check-circle me-1"></i>' + selected.length + ' device(s) excluded.</span>');
    eeRenderLists();
}

async function eeMoveToActive() {
    const list = document.getElementById('ee-excluded-list');
    const selected = Array.from(list.selectedOptions).map(o => o.value);
    if (!selected.length) return;
    eeSetStatus('<span class="spinner-border spinner-border-sm me-1"></span>Saving…');
    let errors = [];
    for (const aid of selected) {
        try {
            const r = await fetch('/api/settings/eagle-eye-exclusions/' + encodeURIComponent(aid), {method: 'DELETE'});
            const d = await r.json();
            if (d.ok) { if (eeState[aid]) eeState[aid].excluded = false; }
            else errors.push(aid + ': ' + d.error);
        } catch(e) { errors.push(aid + ': ' + e); }
    }
    if (errors.length) eeSetStatus('<span class="text-danger">' + errors.join('; ') + '</span>');
    else eeSetStatus('<span class="text-success"><i class="bi bi-check-circle me-1"></i>' + selected.length + ' device(s) restored.</span>');
    eeRenderLists();
}

function eeSetStatus(html) {
    const el = document.getElementById('ee-status');
    if (el) el.innerHTML = html;
}

// Load when tab is clicked or already active on page load
document.addEventListener('DOMContentLoaded', () => {
    const eeTab = document.getElementById('eagleeye-tab');
    if (eeTab) eeTab.addEventListener('shown.bs.tab', eeLoadExclusions);
    if (window.location.hash === '#eagleeye') {
        if (eeTab) bootstrap.Tab.getOrCreateInstance(eeTab).show();
        eeLoadExclusions();
    } else if (eeTab && eeTab.classList.contains('active')) {
        // Tab was restored by localStorage before our listener was attached
        eeLoadExclusions();
    }
});
