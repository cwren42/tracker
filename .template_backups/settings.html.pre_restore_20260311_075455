async function generateSecuritySummary() {
    const btn = document.getElementById('btn-gen-summary');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating…';
    try {
        const resp = await fetch('/api/ai/security-summary/generate', { method: 'POST' });
        const d    = await resp.json();
        if (resp.ok && d.summary) {
            const riskColors = { High:'#f87171', Medium:'#f8a84a', Low:'#5fcf8b', Critical:'#e879f9' };
            const col = riskColors[d.risk_level] || '#8899aa';
            document.getElementById('ai-summary-text').innerHTML =
                `<span style="color:${col};font-weight:600">Risk Level: ${d.risk_level||'?'}</span><br><br>${(d.summary||'').replace(/\n/g,'<br>')}`;
            document.getElementById('ai-summary-result').style.display = 'block';
