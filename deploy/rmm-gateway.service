[Unit]
Description=Tracker RMM Gateway (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=webuser
Group=webuser
WorkingDirectory=/var/www/tracker

Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/var/www/tracker/.secrets.env
UMask=0077

# Gateway venv
ExecStart=/var/www/tracker/rmm_gateway/.venv/bin/uvicorn rmm_gateway.main:app \
  --host 127.0.0.1 --port 8765 \
  --workers 1 \
  --no-access-log

Restart=always
RestartSec=5

# Hardening (safe defaults; adjust if needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/tracker

[Install]
WantedBy=multi-user.target
